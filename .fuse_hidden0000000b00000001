    <script>
      /* ── HOMEPAGE INIT ───────────────────────────────── */
      function renderHomepage() {
        const ht = document.getElementById("heroTitle"),
          hd = document.getElementById("heroDesc");
        if (ht) ht.innerHTML = hero.title;
        if (hd) hd.innerHTML = hero.desc;
        if (hero.resume) {
          ["navResume", "ctaResume"].forEach((id) => {
            const el = document.getElementById(id);
            if (el) el.href = hero.resume;
          });
        }
        const catEl = document.getElementById("catImg");
        if (catEl && hero.cat) catEl.src = hero.cat;
        const mqItems = [
          "Product Design","Branding","UI/UX Research","Design Systems",
          "Web3","Art Direction","9+ Years","Việt Nam","System Thinking",
          "Editorial Layouts","AI × Design","Creative Coding","Digital Experiences","Emotional Design",
        ];
        const mqTrack = document.getElementById("mqt");
        if (mqTrack)
          mqTrack.innerHTML = [...mqItems, ...mqItems]
            .map((x) => `<span class="mq-item"><span class="mq-dot"></span>${x}</span>`)
            .join("");
        const featW = document.getElementById("featW");
        if (featW)
          featW.innerHTML = works.filter((w) => w.featured).slice(0, 3)
            .map((w, i) => fwCardHTML(w, i)).join("");
      }

      renderHomepage();
      (window._dataReady || Promise.resolve(false)).then((fromCloud) => {
        if (fromCloud) renderHomepage();
      }).catch(() => {});

      /* ── CAT ANIMATION ───────────────────────────────── */
      const cat = document.getElementById("catImg");
      if (cat) {
        let targetX = 0,
          targetY = 0,
          currentX = 0,
          currentY = 0,
          isAvoiding = false;

        document.addEventListener("mousemove", (e) => {
          const rect = cat.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const dx = e.clientX - cx,
            dy = e.clientY - cy;
          const dist = Math.sqrt(dx * dx + dy * dy),
            maxDist = 300;
          if (dist < maxDist) {
            const force = (maxDist - dist) / maxDist;
            targetX = -dx * force * 0.45;
            targetY = -dy * force * 0.45;
            isAvoiding = true;
          } else {
            targetX = 0;
            targetY = 0;
            isAvoiding = false;
          }
        });

        (function animateCat() {
          currentX += (targetX - currentX) * 0.11;
          currentY += (targetY - currentY) * 0.11;
          const floatY = isAvoiding ? 0 : Math.sin(Date.now() / 580) * 20;
          cat.style.transform = `translate(${currentX}px, ${currentY + floatY}px)`;
          requestAnimationFrame(animateCat);
        })();
      }
    </script>
