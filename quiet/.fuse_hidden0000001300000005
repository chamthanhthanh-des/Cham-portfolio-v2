    <script>
      function renderQD(q) {
        const idx = posts.findIndex((x) => x.id === q.id);
        const prev = posts[idx - 1],
          next = posts[idx + 1];
        const navL = prev
          ? `<div class="q-ni" onclick="location.href='/quiet/detail.html?id=${prev.id}'"><div class="dir">← Previous</div><div class="ttl">${prev.title}</div></div>`
          : `<div style="background:var(--bg2)"></div>`;
        const navR = next
          ? `<div class="q-ni nx" onclick="location.href='/quiet/detail.html?id=${next.id}'"><div class="dir">Next →</div><div class="ttl">${next.title}</div></div>`
          : `<div style="background:var(--bg2)"></div>`;

        document.title = `${q.title} — Châm Thanh Thanh`;
        const _ogImg = q.cover
          ? `https://chamthanhthanh.com${q.cover}`
          : "https://chamthanhthanh.com/assets/images/thumbnail-web.png";
        const _ogDesc = (q.excerpt || q.lead || "").slice(0, 160);
        const _ogUrl  = `https://chamthanhthanh.com/quiet/detail.html?id=${q.id}`;
        const _set = (id, attr, val) => { const el = document.getElementById(id); if (el) el.setAttribute(attr, val); };
        _set("ogUrl",   "content", _ogUrl);
        _set("ogTitle", "content", `${q.title} — Châm Thanh Thanh`);
        _set("ogDesc",  "content", _ogDesc);
        _set("ogImg",   "content", _ogImg);
        _set("twTitle", "content", `${q.title} — Châm Thanh Thanh`);
        _set("twDesc",  "content", _ogDesc);
        _set("twImg",   "content", _ogImg);

        document.getElementById("qdc").innerHTML = `
    <div class="qd-hero">
      <a class="qd-back" href="/quiet/"><span>←</span><span>Back to Quiet</span></a>
      <div class="qd-meta-row">
        <span class="qd-cat">${q.category}</span>
        <span class="qd-date">${q.date}</span>
        <span class="qd-reading">${q.reading}</span>
      </div>
      <h1 class="qd-title">${q.title}</h1>
    </div>
    
${
  q.cover
    ? `
    <div style="padding: 0 var(--page-padding-x); margin: 48px 0;">
      <img src="${q.cover}" alt="${q.title}"
           style="width: 100%; display: block; border-radius: var(--img-radius); aspect-ratio: 16/9; object-fit: cover;">
    </div>
`
    : ""
}
        
    <div class="qd-body">
      <div class="qd-lead">${q.lead}</div>
      <hr class="qd-divider">
      <div class="qd-text">${q.content}</div>
    </div>
    <div class="q-nav">${navL}${navR}</div>`;
        setTimeout(initReveal, 80);
      }

      function initPostDetail() {
        if (hero.resume) { const r = document.getElementById('navResume'); if (r) r.href = hero.resume; }
        const id = new URLSearchParams(window.location.search).get("id");
        const q = posts.find((x) => x.id === id);
        if (q) renderQD(q);
        else location.href = "/quiet/";
      }
      initPostDetail();
      (window._dataReady || Promise.resolve(false)).then((fromCloud) => {
        if (fromCloud) initPostDetail();
      }).catch(() => {});
    </script>
